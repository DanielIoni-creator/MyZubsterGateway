# ---- AWS AgentCore ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AGENTCORE_API_KEY=your_agentcore_api_key_here

# ---- BASE NETWORK ----
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASESCAN_API_KEY=your_basescan_api_key_here
PRIVATE_KEY=your_private_key_here
MYZ_TOKEN_ADDRESS=your_myz_token_address_here

# ---- FEE & LIMITS ----
MYZ_FEE_PERCENT=2
DAILY_CAP=50
TRANSACTION_CAP=20
ADMIN_WALLET=your_admin_wallet_here

# ---- BOSON PROTOCOL ----
BOSON_PROTOCOL_ADDRESS=your_boson_protocol_address_here

# ---- API & CORS ----
API_URL=http://localhost:10000
FRONTEND_URL=https://my-zubster-2rtopj7hd-myzubster.vercel.app
