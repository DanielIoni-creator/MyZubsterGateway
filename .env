MONGODB_DB_NAME=myzubster
MONGODB_POOL_SIZE=10

# ---- MONERO BLOCKCHAIN ----
MONERO_RPC_URL=http://localhost:18081
MONERO_WALLET_RPC_URL=http://localhost:18082
MONERO_MAIN_WALLET_ADDRESS=45M4DW1ug8bdQowWpxucTpgsfjLbVxbYaAra79VewmBobuuhgqTjyD4R3DzpqLM2veiphcB16n24qN1QbLg3y2PYGK3Qkoe

# ---- TARI WALLET (MYZ) ----
TARI_WALLET_URL=http://localhost:18089
PLATFORM_WALLET_ID=your_platform_wallet_id_here
ESCROW_WALLET_ADDRESS=your_escrow_wallet_address_here

# ---- MONERO WALLET (XMR) ----
XMR_WALLET_URL=http://localhost:18082
XMR_WALLET_PASSWORD=your_monero_wallet_password_here

# ---- AI PROVIDERS ----
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
