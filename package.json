{
  "name": "myzubster-gateway",
  "version": "1.0.0",
  "description": "MyZubster Gateway - Monero Payment Gateway & Animal Registry",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "monero-javascript": "^0.8.4",
    "monero-ts": "^0.11.13",
    "mongoose": "^7.8.11",
    "morgan": "^1.11.0",
    "node-telegram-bot-api": "^1.2.0",
    "payment": "^2.4.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "jest": "^27.5.1",
    "jest-environment-node": "^27.5.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleDirectories": [
      "node_modules",
      "services",
      "src",
      "models",
      ""
    ],
    "moduleNameMapper": {
      "^../../services/webhookOutboundService$": "<rootDir>/services/webhookOutboundService.js",
      "^../../services/webhookOutboundService": "<rootDir>/services/webhookOutboundService.js",
      "^../../models/WebhookSubscription$": "<rootDir>/models/WebhookSubscription.js",
      "^../../models/WebhookDelivery$": "<rootDir>/models/WebhookDelivery.js"
    }
  }
}
