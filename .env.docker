# MyZubster Gateway - Docker Environment Variables
# Copy this file to .env and adjust values as needed

# Node environment
NODE_ENV=development

# Gateway port
GATEWAY_PORT=10000

# MongoDB (handled internally by docker-compose)
# MONGODB_URI=mongodb://mongodb:27017/myzubster

# Monero wallet stub
XMR_WALLET_PORT=18083
XMR_WALLET_URL=http://monero-wallet-stub:18083
XMR_REQUIRED_CONFIRMATIONS=10
XMR_FCMP_PLUS_PLUS_ENABLED=false
XMR_FCMP_REQUIRED_CONFIRMATIONS=10

# Tari wallet stub
TARI_WALLET_PORT=18143
TARI_WALLET_URL=http://tari-wallet-stub:18143

# Frontend (optional, use --profile frontend)
FRONTEND_PORT=3000
