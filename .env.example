# MyZubster Gateway - Environment Configuration
# Copy to .env and fill in your values

# Server
NODE_ENV=production
GATEWAY_PORT=3000

# MongoDB
MONGODB_URI=mongodb://mongo:27017/myzubster

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-secret-key-change-me

# Monero
MONERO_RPC_URL=http://monero-wallet:18082

# ML Service
ML_PORT=5000

# WebSocket
WS_PORT=8080
