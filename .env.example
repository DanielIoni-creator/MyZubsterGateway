# MyZubster Gateway Environment Variables
MONGODB_URI=mongodb://localhost:27017/myzubster
PORT=3001

# Tari Wallet RPC (MYZ)
TARI_RPC_URL=http://localhost:12021/json_rpc
TARI_ESCROW_ADDRESS=tari_escrow_platform

# Monero Wallet RPC (XMR)
MONERO_RPC_URL=http://localhost:18082/json_rpc
MONERO_WALLET_RPC=http://localhost:18083/json_rpc
MONERO_ESCROW_ADDRESS=xmr_escrow_platform

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=myzubster-dev-secret

# Email (Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=myzubster@example.com
